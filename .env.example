# ─────────────────────────────────────────────────────────────────────────────
# TCC Esports — environment variables
# Copy to `.env` for local dev, and add the same keys in Vercel →
# Project → Settings → Environment Variables for production.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
# These are public by design; Firestore security rules protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (free plan) — cloud name + an UNSIGNED upload preset.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=tcc_unsigned

# Gemini (Google AI Studio) — SERVER-ONLY. Never prefix with VITE_ or it will
# be bundled into the public site. Used by /api/gemini (Vercel Edge Function).
GEMINI_API_KEY=
# Optional: any generateContent model your key can use on the free tier.
GEMINI_MODEL=gemini-flash-latest
# Optional: model for the realistic caster voices (Gemini text-to-speech).
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Optional: thinking budget for "thinking" models (e.g. 0 for faster replies on 2.5 Flash models).
# Leave empty if your model doesn't support thinkingConfig.
GEMINI_THINKING_BUDGET=
